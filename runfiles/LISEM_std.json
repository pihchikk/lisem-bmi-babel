{
  "$comment": "LISEM (Limburg Soil Erosion Model) standard descriptor.",
  "model_identification": {
    "$comment": "Short model metadata.",
    "full_name": "LISEM (Limburg Soil Erosion Model) / openLISEM classic",
    "short_name": "LISEM",
    "authors": ["Victor Jetten", "Bastian van den Bout", "contributors"],
    "version": "6.0 (runfile workflow)",
    "last_update": "2025-08-29",
    "model_type": [
      "deterministic",
      "process-based",
      "spatially-distributed",
      "dynamic",
      "event-based"
    ],
    "description": "Event-based model for rainfall–runoff, flooding, and soil erosion with map inputs and map/CSV outputs."
  },

  "policy": {
    "$comment": "Units and conventions.",
    "units": "UDUNITS",
    "standard_names": "CSDMS",
    "nodata": { "float": "NaN", "int": -1 },
    "conventions": { "calendar": "proleptic_gregorian", "time_utc": true }
  },

  "bmi": {
    "$comment": "No BMI wrapper yet; keep stub for compatibility.",
    "available": false,
    "component_name": null,
    "model_class": null,
    "grid": { "type": "uniform_rectilinear", "rank": 2 },
    "input_vars": [],
    "output_vars": [],
    "time": null
  },

  "model_access": {
    "$comment": "How to run the model (runfile).",
    "repository_structure": {
      "root": [
        "runfile.run",
        "maps/  (all rasters same size)",
        "rain.txt (hyetograph)",
        "res/    (output)"
      ]
    },
    "repository_link": "https://lisemmodel.com/",
    "cli_usage": {
      "$comment": "Minimal run.",
      "installation": [
        "Download/install openLISEM classic (Windows/Linux, conda available)",
        "Ensure PCRaster runtime if needed"
      ],
      "examples": [
        "./lisem -r runfile.run",
        "lisem.exe -r runfile.run"
      ]
    }
  },

  "runtime_environment": {
    "$comment": "OS/tools.",
    "operating_system": ["Linux", "Windows"],
    "language": "External binary (C/C++)",
    "dependencies": [],
    "external_tools": ["LISEM classic binary", "PCRaster runtime (for .map)"],
    "hardware_requirements": { "RAM": "depends on domain size", "CPU": "multi-core recommended" }
  },

  "execution_parameters": {
    "$comment": "Scenario, time/space, default units.",
    "scenarios": [
      { "name": "rainstorm_event", "description": "Single rainfall event from rain.txt over the DEM domain." }
    ],
    "config_file_type": "RUN (LISEM runfile)",
    "checkpoints": false,
    "logging": { "format": "text", "level": "INFO" },
    "time": {
      "$comment": "From runfile: Begin=001:0000, End=001:0720, Timestep=120 s.",
      "time_step": 120.0,
      "time_units": "s",
      "simulation_period": "0–43200 s (12 h)"
    },
    "space": {
      "$comment": "Derived from DEM.",
      "cell_size": "from dem.map",
      "crs": "from dem.map (projected, metres)",
      "extent": "from dem.map"
    },
    "units": {
      "$comment": "Outputs; erosion units depend on runfile setting.",
      "soilloss": "kg/m2 or t/ha or m",
      "detachment": "kg/m2 or t/ha or m",
      "deposition": "kg/m2 or t/ha or m",
      "channel_discharge": "m3/s",
      "Vmax": "m/s",
      "whmax": "m"
    },
    "allowed_units": {
      "soilloss": ["kg/m2", "t/ha", "m"],
      "detachment": ["kg/m2", "t/ha", "m"],
      "deposition": ["kg/m2", "t/ha", "m"]
    }
  },

  "grids": [
    {
      "$comment": "Single raster grid.",
      "id": 0,
      "type": "uniform_rectilinear",
      "rank": 2,
      "shape": ["${n_rows}", "${n_cols}"],
      "spacing": ["${dy_m}", "${dx_m}"],
      "origin": ["${y0_m}", "${x0_m}"],
      "crs": { "epsg": "${epsg}", "wkt": null },
      "vertical": { "layers": null, "z_positive": "up" }
    }
  ],

  "variables": {
    "$comment": "Main inputs/outputs (conceptual).",
    "elevation": { "intent": "in", "grid": 0, "units": "m", "standard_name": "land_surface__elevation" },
    "mannings_n": { "intent": "in", "grid": 0, "units": "s m^-1/3", "standard_name": "channel_water_flow__manning_n" },
    "ksat": { "intent": "in", "grid": 0, "units": "m/s", "standard_name": "soil__hydraulic_conductivity" },
    "initial_soil_moisture": { "intent": "in", "grid": 0, "units": "m3/m3", "standard_name": "soil__volumetric_water_content" },
    "interception_capacity": { "intent": "in", "grid": 0, "units": "mm", "standard_name": "canopy_water__storage_capacity" },
    "rainfall_intensity": { "intent": "in", "grid": 0, "units": "mm/h", "standard_name": "atmosphere_water__rainfall_intensity" },

    "soilloss": { "intent": "out", "grid": 0, "units": "kg/m2 or t/ha or m", "standard_name": "land_surface__soil_loss" },
    "detachment": { "intent": "out", "grid": 0, "units": "kg/m2 or t/ha or m", "standard_name": "land_surface__soil_detachment" },
    "deposition": { "intent": "out", "grid": 0, "units": "kg/m2 or t/ha or m", "standard_name": "land_surface__sediment_deposition" },
    "whmax": { "intent": "out", "grid": 0, "units": "m", "standard_name": "land_surface_water__depth_maximum" },
    "Vmax": { "intent": "out", "grid": 0, "units": "m/s", "standard_name": "land_surface_water__velocity_maximum" },
    "floodtime": { "intent": "out", "grid": 0, "units": "s", "standard_name": "land_surface_water__time_of_flooding" },
    "channel_discharge": { "intent": "out", "grid": 0, "units": "m3/s", "standard_name": "channel_water__discharge" },
    "hydrograph_at_outlet": { "intent": "out", "grid": null, "units": "mixed", "standard_name": "basin_outlet__hydrograph" }
  },

  "input_parameters": {
    "$comment": "All inputs referenced in your runfile, grouped as in the UI.",
    "items": [
      { "name": "Map Directory", "abbr": "map_dir", "description": "Folder with input maps", "file_format": "path", "required": true, "value": "/home/jovyan/work/LISEM 3/inputfiles/VNIIMZ_20m/maps" },

      { "group": "Catchment", "maps": [
        { "name": "dem.map", "description": "Digital elevation model", "units": "m", "file_format": "GDAL (e.g., .map, GeoTIFF)", "required": true },
        { "name": "grad.map", "description": "Terrain gradient (optional)", "units": "1", "file_format": "map", "required": false },
        { "name": "ldd.map", "description": "Local drainage direction", "units": "code", "file_format": "map", "required": false },
        { "name": "outlet.map", "description": "Outlet cells", "units": "1", "file_format": "map", "required": false },
        { "name": "outpoint.map", "description": "Outlet points", "units": "1", "file_format": "map", "required": false },
        { "name": "flowboundary.map", "description": "Flow boundary mask", "units": "1", "file_format": "map", "required": false }
      ]},

      { "group": "Landuse", "maps": [
        { "name": "landunit.map", "description": "Land use units", "units": "codes", "file_format": "map", "required": false },
        { "name": "per.map", "description": "Cover fraction", "units": "1", "file_format": "map", "required": false },
        { "name": "litter.map", "description": "Litter properties", "units": "1", "file_format": "map", "required": false },
        { "name": "lai.map", "description": "Leaf area index", "units": "1", "file_format": "map", "required": false },
        { "name": "ch.map", "description": "Canopy height", "units": "m", "file_format": "map", "required": false },
        { "name": "smax.map", "description": "Max interception storage", "units": "mm", "file_format": "map", "required": false }
      ]},

      { "group": "Surface", "maps": [
        { "name": "rr.map", "description": "Surface rain retention parameter", "units": "1", "file_format": "map", "required": false },
        { "name": "n.map", "description": "Manning’s n (roughness)", "units": "s m^-1/3", "file_format": "map", "required": true },
        { "name": "stonefrc.map", "description": "Stone fraction", "units": "1", "file_format": "map", "required": false },
        { "name": "crustfrc.map", "description": "Crust fraction", "units": "1", "file_format": "map", "required": false },
        { "name": "compfrc.map", "description": "Compaction fraction", "units": "1", "file_format": "map", "required": false }
      ]},

      { "group": "Infiltration (layers)", "maps": [
        { "name": "ksat1.map", "description": "Hydraulic conductivity L1", "units": "m/s", "file_format": "map", "required": false },
        { "name": "psi1.map", "description": "Suction head L1", "units": "m", "file_format": "map", "required": false },
        { "name": "thetas1.map", "description": "Saturated theta L1", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "thetai1.map", "description": "Initial theta L1", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "soildep1.map", "description": "Soil depth L1", "units": "m", "file_format": "map", "required": false },

        { "name": "ksat2.map", "description": "Hydraulic conductivity L2", "units": "m/s", "file_format": "map", "required": false },
        { "name": "psi2.map", "description": "Suction head L2", "units": "m", "file_format": "map", "required": false },
        { "name": "thetas2.map", "description": "Saturated theta L2", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "thetai2.map", "description": "Initial theta L2", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "soildep2.map", "description": "Soil depth L2", "units": "m", "file_format": "map", "required": false },

        { "name": "ksat3.map", "description": "Hydraulic conductivity L3", "units": "m/s", "file_format": "map", "required": false },
        { "name": "psi3.map", "description": "Suction head L3", "units": "m", "file_format": "map", "required": false },
        { "name": "thetas3.map", "description": "Saturated theta L3", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "thetai3.map", "description": "Initial theta L3", "units": "m3/m3", "file_format": "map", "required": false },
        { "name": "soildep3.map", "description": "Soil depth L3", "units": "m", "file_format": "map", "required": false },

        { "name": "omcorr.map", "description": "Organic matter correction", "units": "1", "file_format": "map", "required": false },
        { "name": "densfact.map", "description": "Density factor", "units": "1", "file_format": "map", "required": false },
        { "name": "ksatcrst.map", "description": "Ksat crust", "units": "m/s", "file_format": "map", "required": false },
        { "name": "porecrst.map", "description": "Pore crust", "units": "1", "file_format": "map", "required": false },
        { "name": "ksatcomp.map", "description": "Ksat compacted", "units": "m/s", "file_format": "map", "required": false },
        { "name": "porecomp.map", "description": "Pore compacted", "units": "1", "file_format": "map", "required": false }
      ]},

      { "group": "Channels & Groundwater", "maps": [
        { "name": "lddchan.map", "description": "Channel LDD", "units": "code", "file_format": "map", "required": false },
        { "name": "chanwidt.map", "description": "Channel width", "units": "m", "file_format": "map", "required": false },
        { "name": "chandepth.map", "description": "Channel depth", "units": "m", "file_format": "map", "required": false },
        { "name": "changrad.map", "description": "Channel gradient", "units": "1", "file_format": "map", "required": false },
        { "name": "chanside.map", "description": "Channel side slope", "units": "1", "file_format": "map", "required": false },
        { "name": "chandiameter.map", "description": "Culvert diameter", "units": "m", "file_format": "map", "required": false },
        { "name": "chanculvert.map", "description": "Culvert index", "units": "1", "file_format": "map", "required": false },
        { "name": "chanman.map", "description": "Channel Manning n", "units": "s m^-1/3", "file_format": "map", "required": false },
        { "name": "chanksat.map", "description": "Channel Ksat", "units": "m/s", "file_format": "map", "required": false },
        { "name": "QinPoints.map", "description": "Inflow points", "units": "1", "file_format": "map", "required": false },
        { "name": "chancoh.map", "description": "Channel cohesion", "units": "Pa", "file_format": "map", "required": false },
        { "name": "baseflow.map", "description": "Baseflow magnitude", "units": "m3/s", "file_format": "map", "required": false },
        { "name": "lddbaseflow.map", "description": "Baseflow LDD", "units": "code", "file_format": "map", "required": false },
        { "name": "basedistance.map", "description": "Baseflow distance", "units": "m", "file_format": "map", "required": false },
        { "name": "WHinit.map", "description": "Initial water height", "units": "m", "file_format": "map", "required": false },
        { "name": "WHboundary.map", "description": "Boundary water height", "units": "m", "file_format": "map", "required": false }
      ]},

      { "group": "Buildings & Roads", "maps": [
        { "name": "roadwidt.map", "description": "Road width", "units": "m", "file_format": "map", "required": false },
        { "name": "housecover.map", "description": "House cover fraction", "units": "1", "file_format": "map", "required": false },
        { "name": "roofstore.map", "description": "Roof storage", "units": "mm", "file_format": "map", "required": false },
        { "name": "drumstore.map", "description": "Drum storage", "units": "mm", "file_format": "map", "required": false },
        { "name": "hardsurf.map", "description": "Hard surface fraction", "units": "1", "file_format": "map", "required": false }
      ]},

      { "group": "Erosion", "maps": [
        { "name": "coh.map", "description": "Soil cohesion", "units": "Pa", "file_format": "map", "required": false },
        { "name": "cohadd.map", "description": "Additional cohesion", "units": "Pa", "file_format": "map", "required": false },
        { "name": "aggrstab.map", "description": "Aggregate stability", "units": "1", "file_format": "map", "required": false },
        { "name": "d50_copy.map", "description": "Median grain size (D50)", "units": "mm", "file_format": "map", "required": false },
        { "name": "d90_copy.map", "description": "Grain size (D90)", "units": "mm", "file_format": "map", "required": false }
      ]},

      { "group": "Mitigation", "maps": [
        { "name": "buffers.map", "description": "Buffer strips", "units": "1", "file_format": "map", "required": false },
        { "name": "gridretention.map", "description": "Grid retention", "units": "1", "file_format": "map", "required": false },
        { "name": "chanretention.map", "description": "Channel retention", "units": "1", "file_format": "map", "required": false },
        { "name": "sedretmax.map", "description": "Max sediment retention", "units": "1", "file_format": "map", "required": false },
        { "name": "grasswid.map", "description": "Grass strip width", "units": "m", "file_format": "map", "required": false },
        { "name": "ksatgras.map", "description": "Grass Ksat", "units": "m/s", "file_format": "map", "required": false },
        { "name": "poregras.map", "description": "Grass porosity", "units": "1", "file_format": "map", "required": false },
        { "name": "cohgras.map", "description": "Grass cohesion", "units": "Pa", "file_format": "map", "required": false },
        { "name": "flowbarrierindex.map", "description": "Flow barrier index", "units": "1", "file_format": "map", "required": false }
      ]},

      { "group": "Storm/Tile drains", "maps": [
        { "name": "lddtile.map", "description": "Tile drain LDD", "units": "code", "file_format": "map", "required": false },
        { "name": "tilediameter.map", "description": "Tile diameter", "units": "m", "file_format": "map", "required": false },
        { "name": "tilewidth.map", "description": "Tile width", "units": "m", "file_format": "map", "required": false },
        { "name": "tileheight.map", "description": "Tile height", "units": "m", "file_format": "map", "required": false },
        { "name": "tiledepth.map", "description": "Tile depth", "units": "m", "file_format": "map", "required": false },
        { "name": "tilegrad.map", "description": "Tile gradient", "units": "1", "file_format": "map", "required": false },
        { "name": "tileman.map", "description": "Tile Manning n", "units": "s m^-1/3", "file_format": "map", "required": false }
      ]},

      { "group": "Time input (rain/ET)", "items": [
        { "name": "rain.txt", "description": "Rainfall time series", "units": "mm/h vs time", "file_format": "txt", "required": true, "directory": "/home/jovyan/work/LISEM 3/inputfiles/VNIIMZ_20m" }
      ]}

    ]
  },

  "output_parameters": {
    "$comment": "Outputs from your runfile.",
    "items": [
      { "name": "totals.csv", "abbr": "Totals", "description": "Main summary (event totals)", "file_format": "csv" },
      { "name": "totalseries.csv", "abbr": "TotalSeries", "description": "Totals over time", "file_format": "csv" },
      { "name": "hydrographs.csv", "abbr": "Hydrographs", "description": "Point/outlet hydrographs", "file_format": "csv" },
      { "name": "totlandunit.csv", "abbr": "LandUnitTotals", "description": "Totals per land unit", "file_format": "csv" },
      { "name": "floodstats.csv", "abbr": "FloodStats", "description": "Flood statistics", "file_format": "csv" },

      { "name": "rainfall.map", "description": "Rainfall", "units": "mm or mm/h", "file_format": "map" },
      { "name": "interception.map", "description": "Interception storage", "units": "mm", "file_format": "map" },
      { "name": "infiltration.map", "description": "Infiltrated water", "units": "mm or m", "file_format": "map" },
      { "name": "Flowcumm3.map", "description": "Cumulative runoff", "units": "m3", "file_format": "map" },
