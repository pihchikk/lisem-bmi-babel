      { "name": "Vmax.map", "description": "Max overland velocity", "units": "m/s", "file_format": "map" },
      { "name": "VHmax.map", "description": "Max momentum", "units": "m2/s2 (proxy)", "file_format": "map" },
      { "name": "floodtime.map", "description": "Time of flooding", "units": "s", "file_format": "map" },
      { "name": "floodstart.map", "description": "Start of flooding", "units": "s", "file_format": "map" },
      { "name": "Stormdrain.map", "description": "Storm drain flow/areas", "file_format": "map" },

      { "name": "detachment.map", "description": "Soil detachment", "units": "kg/m2 or t/ha or m", "file_format": "map" },
      { "name": "deposition.map", "description": "Sediment deposition", "units": "kg/m2 or t/ha or m", "file_format": "map" },
      { "name": "soilloss.map", "description": "Net soil loss (erosion–deposition)", "units": "kg/m2 or t/ha or m", "file_format": "map" },
      { "name": "chandet.map", "description": "Channel detachment", "units": "kg/m2 or t/ha or m", "file_format": "map" },
      { "name": "chandep.map", "description": "Channel deposition", "units": "kg/m2 or t/ha or m", "file_format": "map" }
    ],
    "report_format_geotiff": 0,
    "result_directory": "/home/jovyan/work/LISEM 3/inputfiles/VNIIMZ_20m/res",
    "add_timestamp": 0,
    "report_digits_out": 3,
    "minimum_reported_flood_height_m": 0.05,
    "end_run_report": 1
  },

  "time_control": {
    "$comment": "Event window and dt.",
    "start": "0 s",
    "end": "43200 s",
    "dt": { "type": "fixed", "value": 120.0, "units": "s" },
    "spinup": { "enabled": false, "period": 0, "units": "s" },
    "restart": { "read": null, "write_interval_steps": 0 }
  },

  "conditions": {
    "$comment": "IC/BC/forcing.",
    "initial_conditions": ["soil moisture maps (thetai*)", "optional WHinit"],
    "boundary_conditions": ["flowboundary map", "optional WHboundary"],
    "forcing": ["rain.txt hyetograph (bias correction optional)"]
  },

  "numerics": {
